#include<stdio.h>
#include<string.h>

char p[26][20], lhs[26], rhs[26][20];
char in[50], st[50];
int n, pos = 0, sl = 0;

void conv(char *s,char *t){
	int i,j;
	for(i=0,j=0; s[i]; i++,j++){
		t[j] = s[i];
		if(s[i]=='i') i++;
	}	
	t[j] = '\0';
}

void print(char *s){
	for(int i=0; s[i]; i++){
		if(s[i]=='i') printf("id");
		else printf("%c",s[i]);
	}
}

void show(char *action){
	printf("$");
	print(st);
	printf("\t\t");
	print(in+pos);
	printf("$\t\t%s\n",action);
}

int reduce(){
	char buff[50];
	for(int i=0; i<n;i++){
		int len = strlen(rhs[i]);
		if(len<=sl && strcmp(st+sl-len,rhs[i])==0){
			if(strchr(rhs[i],'+')&& in[pos] == '*') continue;
			sl -= len;
			st[sl++] = lhs[i];
			st[sl] = '\0';
			sprintf(buff,"REDUCED TO %c(%s)",lhs[i],p[i]);
			show(buff);
			return 1;
		}
	}
	return 0;
}

int main(){
	char temp[50];
	printf("Enter no of productions: ");
	scanf("%d",&n);
	printf("Enter production rules:\n");
	for(int i=0;i<n;i++){
		scanf("%s",p[i]);
		lhs[i] = p[i][0];
		conv(p[i]+3,rhs[i]);		
	}
	printf("\nEnter input string: ");
	scanf("%s",temp);
	conv(temp,in);
	
	printf("\n\nSTACK\t\tINPUT\t\tACTION\n\n");
	show("--");
	while(in[pos]){
		st[sl++] = in[pos++];
		st[sl] = '\0';
		show(st[sl-1] == 'i'?"SHIFT->id":"SHIFT");
		reduce();
	}
	while(reduce());
	show(sl==1 && st[0]==lhs[0]?"ACCEPT":"REJECT");
	return 0;
}

exp8.y

%{
#include <stdio.h>
#include <stdlib.h>

int yylex(void);
void yyerror(const char *s);
%}

%token DIGIT NL

%left '+' '-'
%left '*' '/'
%right '^'
%%
stmt : exp NL
       {
           printf("Result = %d\n", $1);
       }
     ;
exp  : exp '+' exp
       { $$ = $1 + $3; }
     | exp '-' exp
       { $$ = $1 - $3; }
     | exp '*' exp
       { $$ = $1 * $3; }
     | exp '/' exp
       {
           if ($3 == 0) {
               printf("Division by zero\n");
               exit(1);
           }
           $$ = $1 / $3;
       }
     | exp '^' exp
       {
           int result = 1;
           int i;

           for (i = 0; i < $3; i++)
               result = result * $1;
           $$ = result;
       }
     | '(' exp ')'
       { $$ = $2; }
     | DIGIT
       { $$ = $1; }
     ;
%%
void yyerror(const char *s)
{
    printf("Invalid Expression\n");
}
int main()
{
    printf("Enter expression: ");
    yyparse();
    return 0;
}

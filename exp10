#include <stdio.h>
#include <string.h>
#include <ctype.h>

char lhs[20], rhs[20][20];
char first[20][20], follow[20][20];
int n;

void add(char set[], char c)
{
    int i;
    for (i = 0; set[i]; i++)
        if (set[i] == c)
            return;

    i = strlen(set);
    set[i] = c;
    set[i + 1] = '\0';
}

/* Find FIRST of a non-terminal */
void FIRST(char c)
{
    int i, j;
    char x;

    for (i = 0; i < n; i++) {
        if (lhs[i] != c)
            continue;

        x = rhs[i][0];

        if (x == '#')
            add(first[c - 'A'], '#');

        else if (!isupper(x))
            add(first[c - 'A'], x);

        else {
            FIRST(x);

            for (j = 0; first[x - 'A'][j]; j++)
                add(first[c - 'A'], first[x - 'A'][j]);
        }
    }
}

/* Find FOLLOW of a non-terminal */
void FOLLOW(char c)
{
    int i, j, k;
    char x;

    if (c == lhs[0])
        add(follow[c - 'A'], '$');

    for (i = 0; i < n; i++) {
        for (j = 0; rhs[i][j]; j++) {
            if (rhs[i][j] == c) {

                x = rhs[i][j + 1];

                if (x && !isupper(x))
                    add(follow[c - 'A'], x);

                else if (isupper(x)) {
                    FIRST(x);

                    for (k = 0; first[x - 'A'][k]; k++)
                        if (first[x - 'A'][k] != '#')
                            add(follow[c - 'A'],
                                first[x - 'A'][k]);
                }

                else if (lhs[i] != c)
                    FOLLOW(lhs[i]);
            }
        }
    }
}

int main()
{
    int i, j;
    char p[50], *arrow;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions (example E->TR or E=TR):\n");

    for (i = 0; i < n; i++) {
        scanf("%s", p);

        lhs[i] = p[0];

        arrow = strstr(p, "->");

        if (arrow != NULL)
            strcpy(rhs[i], arrow + 2);
        else
            strcpy(rhs[i], strchr(p, '=') + 1);
    }

    /* Calculate FIRST */
    for (i = 0; i < n; i++)
        FIRST(lhs[i]);

    /* Calculate FOLLOW */
    for (i = 0; i < n; i++)
        FOLLOW(lhs[i]);

    printf("\nFIRST sets:\n");
    for (i = 0; i < n; i++) {
        printf("FIRST(%c) = { %s }\n",
               lhs[i], first[lhs[i] - 'A']);
    }

    printf("\nFOLLOW sets:\n");
    for (i = 0; i < n; i++) {
        printf("FOLLOW(%c) = { %s }\n",
               lhs[i], follow[lhs[i] - 'A']);
    }

    return 0;
}

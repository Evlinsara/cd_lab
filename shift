
#include <stdio.h>
#include <string.h>

char p[20][30], stack[100], input[100];
int n, top = -1, pos = 0;

// Convert id into a single symbol i
void convert(char s[], char d[])
{
    int i = 0, j = 0;

    while(s[i])
    {
        if(s[i] == 'i' && s[i+1] == 'd')
        {
            d[j++] = 'i';
            i += 2;
        }
        else
            d[j++] = s[i++];
    }
    d[j] = '\0';
}

// Display stack, input and action
void show(char action[])
{
    int i;

    printf("$");
    for(i = 0; i <= top; i++)
    {
        if(stack[i] == 'i')
            printf("id");
        else
            printf("%c", stack[i]);
    }

    printf("\t\t");

    for(i = pos; input[i]; i++)
    {
        if(input[i] == 'i')
            printf("id");
        else
            printf("%c", input[i]);
    }

    printf("$\t\t%s\n", action);
}

// Perform reduction
int reduce()
{
    int i, len;
    char rhs[30], action[100];

    for(i = 0; i < n; i++)
    {
        convert(p[i] + 3, rhs);
        len = strlen(rhs);

        if(len <= top + 1 &&
           strncmp(stack + top - len + 1, rhs, len) == 0)
        {
            // Give * higher precedence than +
            if(strcmp(rhs, "E+E") == 0 &&
               input[pos] == '*')
                continue;

            top -= len;
            stack[++top] = p[i][0];

            sprintf(action, "REDUCE TO %c (%s)",
                    p[i][0], p[i]);

            if(input[pos] == '\0' &&
               top == 0 && stack[0] == p[0][0])
                strcat(action, " / ACCEPT");

            show(action);
            return 1;
        }
    }
    return 0;
}

int main()
{
    int i;
    char temp[100];

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter grammar productions:\n");
    for(i = 0; i < n; i++)
        scanf("%29s", p[i]);

    printf("Enter input string: ");
    scanf("%99s", temp);

    convert(temp, input);

    printf("\nStack\t\tInput\t\tAction\n");
    printf("$\t\t%s$\t\t--\n", temp);

    // Shift and reduce
    while(input[pos] != '\0')
    {
        stack[++top] = input[pos++];
        show("SHIFT");

        while(reduce());
    }

    while(reduce());

    // Check acceptance
    if(top == 0 && stack[0] == p[0][0])
        printf("\nInput string is ACCEPTED.\n");
    else
        printf("\nInput string is REJECTED.\n");

    return 0;
}

%{
#include "y.tab.h"
%}
%%
[a-zA-Z_][a-zA-Z0-9_]*  { return ID; }
\n                      { return NL; }
.                       { return yytext[0]; }
%%
int yywrap()
{
    return 1;
}

exp7.y

%{
#include <stdio.h>
int yylex(void);
int yyerror(const char *s);
%}
%token ID NL
%%
input : /* empty */
      | input stmt
      ;
stmt  : ID NL
      {
          printf("Valid Identifier\n");
      }
      | error NL
      {
          printf("Invalid Identifier\n");
          yyerror;
      }
      ;
%%
int main()
{
    printf("Enter identifiers (one per line):\n");
    yyparse();
    return 0;
}
int yyerror(const char *s)
{
    return 0;
}

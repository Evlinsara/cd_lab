calc.l

%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%
[0-9]+    { yylval = atoi(yytext); return NUMBER; }
[ \t]     ;                         /* Ignore spaces and tabs */
\n        { return '\n'; }
.         { return yytext[0]; }     /* Return +, -, etc. */
%%

int yywrap()
{
    return 1;
}

calc.y

%{
#include <stdio.h>

int yylex(void);
void yyerror(const char *s);
%}

%token NUMBER
%left '+' '-'

%%
input : expr '\n'  { printf("Result = %d\n", $1); }
      ;

expr  : expr '+' expr  { $$ = $1 + $3; }
      | expr '-' expr  { $$ = $1 - $3; }
      | NUMBER         { $$ = $1; }
      ;
%%

int main()
{
    printf("Enter an arithmetic expression:\n");
    return yyparse();
}

void yyerror(const char *s)
{
    printf("Invalid expression\n");
}

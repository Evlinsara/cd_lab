#include <stdio.h>
#include <string.h>

int main()
{
    char expr[100], operand[50][10], op[50];
    char temp[10];
    int i, j, n = 0, m = 0, t = 1;

    printf("Enter expression: ");
    scanf("%s", expr);

    /* Separate operands and operators */
    for (i = 0; expr[i] != '\0'; i++)
    {
        operand[n][0] = expr[i];
        operand[n][1] = '\0';
        n++;

        if (expr[i + 1] != '\0')
            op[m++] = expr[++i];
    }

    printf("\nIntermediate code:\n");

    /* First process multiplication and division */
    for (i = 0; i < m; i++)
    {
        if (op[i] == '*' || op[i] == '/')
        {
            printf("T%d := %s %c %s\n",
                   t, operand[i], op[i], operand[i + 1]);

            sprintf(temp, "T%d", t++);
            strcpy(operand[i], temp);

            /* Remove the used operand and operator */
            for (j = i + 1; j < n - 1; j++)
                strcpy(operand[j], operand[j + 1]);

            for (j = i; j < m - 1; j++)
                op[j] = op[j + 1];

            n--;
            m--;
            i--;
        }
    }

    /* Then process addition and subtraction */
    while (m > 0)
    {
        printf("T%d := %s %c %s\n",
               t, operand[0], op[0], operand[1]);

        sprintf(temp, "T%d", t++);
        strcpy(operand[0], temp);

        /* Shift remaining operands and operators */
        for (i = 1; i < n - 1; i++)
            strcpy(operand[i], operand[i + 1]);

        for (i = 0; i < m - 1; i++)
            op[i] = op[i + 1];

        n--;
        m--;
    }

    return 0;
}

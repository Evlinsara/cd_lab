%{
#include <stdio.h>
%}
%%
if|else|int|switch|char|main  { printf("%s is a keyword\n", yytext); }
[a-zA-Z_][a-zA-Z0-9_]*        { printf("%s is an identifier\n", yytext); }
[0-9]+                        { printf("%s is a number\n", yytext); }
[+\-*/%=<>!]                  { printf("%s is an operator\n", yytext); }
\n                            ;
[ \t]                         ;
[;]                           { printf("%s: delimiter\n", yytext); }
.                             ;
%%
int yywrap()
{
    return 1;
}
int main()
{
    printf("Enter the input text:\n");
    yylex();
    return 0;
}

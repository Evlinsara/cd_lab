%{
#define YY_SKIP_YYWRAP
int yywrap() { return 1; }
%}

%%
"if"|"else"|"int"|"switch"|"char"   { printf("%s is a keyword\n", yytext); }
[a-z_][a-z0-9_]* { printf("%s is an identifier\n", yytext); }
[0-9]+                              { printf("%s is a number\n", yytext); }
"="|"+"|"*"|"/"|"<"|">"             { printf("%s is an operator\n", yytext); }
"\n"                                { printf("Newline encountered. Exiting...\n"); return 0; }
[ \t]                               { /* Ignore whitespace and tabs */ }
.                                   { printf("%s is an invalid character\n", yytext); }
%%

int main() {
    printf("Enter the input text:\n");
    yylex();
    return 0;
}
